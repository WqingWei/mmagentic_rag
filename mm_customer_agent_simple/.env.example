# 阿里云百炼 / DashScope API Key
DASHSCOPE_API_KEY=

# 你给出的 OpenAI 兼容模式地址，用于 embedding 与 qwen-plus 生成
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# qwen3-rerank 官方 OpenAI 兼容地址，用于 /reranks
DASHSCOPE_RERANK_BASE_URL=https://dashscope.aliyuncs.com/compatible-api/v1

EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIM=1024
RERANK_MODEL=qwen3-rerank
LLM_MODEL=qwen-plus
AGENTSCOPE_MAX_ITERS=4
MAX_IMAGE_INPUTS=10
OCR_LANGUAGES=ch_sim,en
OCR_MODEL_STORAGE_DIR=storage/easyocr_models
IMAGE_ANALYSIS_TOOLS=ocr,api_vlm
API_VLM_MODEL=qwen-vl-plus
API_VLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LOCAL_VLM_ENABLED=false
LOCAL_VLM_BASE_URL=http://127.0.0.1:8001/v1
LOCAL_VLM_MODEL=

# 默认使用 qdrant-client 本地文件存储，不需要启动 Docker / Qdrant 服务
STORAGE_DIR=storage
QDRANT_COLLECTION=manual_chunks

VECTOR_TOP_K=50
BM25_TOP_K=50
RRF_K=60
RERANK_TOP_K=8
FINAL_CONTEXT_TOP_K=6

# 客服常见问题检索功能。默认状态下已关闭，以保留大模型原本的直连调用链路。
ENABLE_CUSTOMER_QA_RETRIEVAL=false
CUSTOMER_QA_PATH=FAQ.json
CUSTOMER_QA_QDRANT_PATH=storage/customer_qa_qdrant
CUSTOMER_QA_QUERY_COLLECTION=customer_qa_query
CUSTOMER_QA_ANSWER_COLLECTION=customer_qa_answer
CUSTOMER_QA_VECTOR_TOP_K=3
CUSTOMER_QA_MIN_VECTOR_SCORE=0.35
CUSTOMER_QA_MIN_VECTOR_SCORE_GAP=1.1
